# Local development only. Never enable local mode on a hosted service.
APP_MODE=local
APP_ORIGIN=http://127.0.0.1:3000
DEFAULT_TIMEZONE=America/Denver
LOCAL_DATA_DIR=.data
# A base64-encoded random 32-byte key; setup:local generates a local value.
APP_SECRET_KEY=
# cloud mode uses attached identities / ADC, never committed key files.
GOOGLE_CLOUD_PROJECT=
GCP_REGION=us-central1
STORAGE_BUCKET=
TASK_QUEUE=reader-processing
WORKER_URL=
TASK_SERVICE_ACCOUNT=
SERVICE_ROLE=web
# Internal Google OAuth web client. Redirect: APP_ORIGIN/api/auth/callback
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
TTS_VOICES=en-US-Standard-C,en-US-Standard-D
MAX_UPLOAD_BYTES=12582912
MAX_PAGES=30
MAX_SEGMENTS=500
MAX_DOCUMENT_CHARACTERS=60000
MAX_DOCUMENTS_PER_OWNER=30
MAX_UPLOADS_PER_DAY=10
MAX_CHARACTERS_PER_DAY=150000
WORKER_BATCH_SIZE=12
